# ============================================================================
# Databases
# ============================================================================
# Four separate databases: one control plane (jobs, files, conversations, audit)
# and one per RAG access tier. The tier separation is physical, not a WHERE
# clause, and it is the security property the whole design rests on.
#
# !! Do NOT set DATABASE_URL on its own. !!
# The three tier variables fall back to DATABASE_URL when unset:
#     admin_database_url = os.getenv('ADMIN_DATABASE_URL', os.getenv('DATABASE_URL', ...))
# so pointing a local run at Postgres with DATABASE_URL alone -- the obvious
# move -- silently collapses the control plane and all three tiers into one
# database, and every tier can then read every document. REQUIRE_POSTGRES does
# not catch this, because all four *are* Postgres.
#
# Either leave all four unset (the default below: four distinct SQLite files,
# correctly isolated) or set all four. docker-compose.yml sets all four.
#
# DATABASE_URL=postgresql+psycopg://orchestrator:${POSTGRES_PASSWORD}@postgres:5432/orchestrator
# ADMIN_DATABASE_URL=postgresql+psycopg://rag_admin:${ADMIN_DB_PASSWORD}@admin-db:5432/rag_admin
# HIGHER_DATABASE_URL=postgresql+psycopg://rag_higher:${HIGHER_DB_PASSWORD}@higher-db:5432/rag_higher
# LOWER_DATABASE_URL=postgresql+psycopg://rag_lower:${LOWER_DB_PASSWORD}@lower-db:5432/rag_lower
#
# To check what a given .env actually resolves to:
#   set -a; . ./.env; set +a
#   .venv/bin/python -c "
#   from app.config import settings
#   print('control:', settings.database_url)
#   for t,u in settings.tier_database_urls.items(): print(f'{t:>7}:', u)
#   print('distinct:', len({settings.database_url, *settings.tier_database_urls.values()}))"
# Expect distinct: 4.

# Passwords consumed by docker-compose.yml when it builds the URLs above.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Three physically separate pgvector databases (admin/higher/lower tiers).
# Use a distinct random password for each -- these are not interchangeable.
ADMIN_DB_PASSWORD=replace-with-a-long-random-password
HIGHER_DB_PASSWORD=replace-with-a-long-random-password
LOWER_DB_PASSWORD=replace-with-a-long-random-password

# ============================================================================
# Authentication
# ============================================================================
# jwt (default) validates bearer tokens; api_key accepts a shared X-API-Key instead.
AUTH_MODE=jwt
JWT_SECRET=replace-with-a-long-random-jwt-secret
# Local GUI integration only. Never enable in a shared or internet-facing environment.
DEV_AUTH_ENABLED=true
DEV_AUTH_TTL_SECONDS=900
DEV_ADMIN_PASSWORD=change-admin-test-password
DEV_HIGHER_PASSWORD=change-higher-test-password
DEV_LOWER_PASSWORD=change-lower-test-password
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production OIDC alternative (asymmetric tokens; JWT_SECRET is then unused):
# OIDC_ISSUER=https://identity.example.com/
# OIDC_AUDIENCE=sovereign-agent-orchestrator
# OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# JWT_PUBLIC_KEY=   # PEM for a static verification key; \n escapes are expanded
# Required when AUTH_MODE=api_key. Every caller then shares one key, so identity comes
# from the X-User-Id / X-User-Role headers, falling back to these. API_ROLE decides the
# access tier for any request that sends no role header -- do not leave it at admin.
# API_KEY=
# API_USER_ID=api-user
# API_ROLE=lower
# Fallbacks when a request carries no X-Tenant-Id / X-Clearance header.
# DEFAULT_TENANT_ID=default
# DEFAULT_CLEARANCE=internal

# ============================================================================
# Server
# ============================================================================
# 0.0.0.0 publishes on every interface -- bind 127.0.0.1 for a local-only run.
# APP_NAME=Sovereign Agent Orchestrator
# API_HOST=0.0.0.0
API_PORT=8080
# WORKSPACE_ROOT=./workspace
# The API process also runs the job worker. Set false to run workers separately.
# RUN_WORKER=true
WORKER_CONCURRENCY=1
MAX_UPLOAD_BYTES=52428800
USER_STORAGE_QUOTA_BYTES=5368709120
RATE_LIMIT_PER_MINUTE=120
# Upload virus scanning via ClamAV. MALWARE_SCAN_REQUIRED=true with no CLAMAV_HOST
# set makes every upload fail with 503 MALWARE_SCANNER_UNAVAILABLE -- the flag is a
# hard gate, not a preference. Leave it false unless CLAMAV_HOST is configured.
MALWARE_SCAN_REQUIRED=false
# CLAMAV_HOST=
# CLAMAV_PORT=3310

# ============================================================================
# Models
# ============================================================================
# MODEL_MODE=fake runs the whole pipeline with no model server (tests/offline demo).
# MODEL_MODE=ollama uses the local Ollama server; the router then picks a model per
# task from config/models.yaml and OLLAMA_MODEL is the fallback / default.
MODEL_MODE=fake
OLLAMA_BASE_URL=http://localhost:11434
# Strong set (pull with plain `ollama pull`, no local GGUF/Modelfile needed):
#   ollama pull qwen3.6:27b   # reasoner + coder + calc + docs + general (~17 GB)
#   ollama pull qwen3-vl:8b   # vision: scans, screenshots, drawings, handwriting (~6 GB)
#   ollama pull bge-m3        # embeddings, multilingual (~1.2 GB)
OLLAMA_MODEL=qwen3.6:27b
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_KEEP_ALIVE=30m
# 32K fits long documents/code with no measured generation-speed cost on a 32 GB
# M1 Max (benchmarked: 8K/32K/64K context all generate at ~7.2-7.7 tok/s with
# qwen3.6:27b; wired memory only grows ~1 GB going 8K->32K). Model max is 256K.
OLLAMA_NUM_CTX=32768
# Probe the host and pick a model automatically. Only takes effect when OLLAMA_MODEL
# is unset, so setting OLLAMA_MODEL above disables it.
# AUTO_CONFIG=true
# Set these when starting `ollama serve` (not read by this app):
#   OLLAMA_FLASH_ATTENTION=1     benchmarked +25% generation speed (6.1 -> 7.7 tok/s)
#   OLLAMA_KV_CACHE_TYPE=q8_0    same speed, ~half the KV-cache memory -- banks
#                                headroom for the bigger context above
#   OLLAMA_NUM_PARALLEL=1        single local user; avoids allocating KV cache
#                                for request slots that are never used
#   OLLAMA_MAX_LOADED_MODELS=1   keeps one heavy model resident at a time on 32 GB
# Suppresses chain-of-thought where the model honours it. Note that not every model
# does: qwen3-vl:8b reasons regardless and emits <think> tags inline, which the
# adapter strips. Keep false; raise LLM_MAX_TOKENS if you enable it.
LLM_ENABLE_THINKING=false
LLM_MAX_TOKENS=1536
# Ollama request timeout. Empty = auto (num_predict/3 + 120s) so a big
# LLM_MAX_TOKENS on a slow/cold model isn't cut off mid-generation.
LLM_TIMEOUT_SECONDS=

# ============================================================================
# Document OCR
# ============================================================================
# Send images / scanned PDFs to the local vision model instead of Tesseract (better on
# scans/forms/handwriting, slower). Leaving this false still falls back to the vision
# model per-file when Tesseract returns nothing usable, so scans are not lost.
OCR_PREFER_VISION=false
# Wall-clock budget for one vision-OCR pass. Ingest is synchronous -- an upload waits on
# this -- and a dense engineering drawing measured at 393s on an 8B vision model, so it
# will not always finish. On a timeout the file is indexed as "no readable text" rather
# than as OCR noise, and questions about it are answered from the image itself, which the
# orchestrator attaches to the task.
OCR_VISION_TIMEOUT_SECONDS=180

# ============================================================================
# Agent loop bounds
# ============================================================================
MAX_ITERATIONS=3
MAX_TOOL_CALLS=12
# JOB_TIMEOUT_SECONDS=120
# TOOL_TIMEOUT_SECONDS=30
# Fail verification when a job's answer is not backed by retrieved evidence.
REQUIRE_EVIDENCE=false

# ============================================================================
# Tools
# ============================================================================
# The send_email tool raises SMTP_NOT_CONFIGURED unless SMTP_HOST is set; without it
# email and calendar tools only write auditable draft JSON into the job workspace.
# SMTP_HOST=
# SMTP_PORT=25
# SMTP_FROM=orchestrator@localhost

# ============================================================================
# Air-gap / production
# ============================================================================
# Refuse to start unless the control DB and all three RAG tier DBs are PostgreSQL.
REQUIRE_POSTGRES=false
# Embedding vector width; must match the embedding model (bge-m3 / qwen3-embedding = 1024, nomic-embed-text = 768).
RAG_EMBEDDING_DIMENSIONS=1024
# Egress status surface (GET /api/v1/system/network, `cli.py doctor`). These do
# not enforce anything -- the deployment blocks outbound traffic. They report it.
OLLAMA_NO_CLOUD=true
NETWORK_FORBIDDEN=false
# OLLAMA_CLOUD_ENDPOINT=   # leave unset; if set, doctor / /system/network flag it
