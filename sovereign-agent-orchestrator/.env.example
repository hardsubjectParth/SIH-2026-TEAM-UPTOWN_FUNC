POSTGRES_PASSWORD=replace-with-a-long-random-password
# Three physically separate pgvector databases (admin/higher/lower tiers).
# Use a distinct random password for each -- these are not interchangeable.
ADMIN_DB_PASSWORD=replace-with-a-long-random-password
HIGHER_DB_PASSWORD=replace-with-a-long-random-password
LOWER_DB_PASSWORD=replace-with-a-long-random-password
AUTH_MODE=jwt
# Local GUI integration only. Never enable in a shared or internet-facing environment.
DEV_AUTH_ENABLED=true
DEV_AUTH_TTL_SECONDS=900
DEV_ADMIN_PASSWORD=change-admin-test-password
DEV_HIGHER_PASSWORD=change-higher-test-password
DEV_LOWER_PASSWORD=change-lower-test-password
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-a-long-random-jwt-secret
# Production OIDC alternative:
# OIDC_ISSUER=https://identity.example.com/
# OIDC_AUDIENCE=sovereign-agent-orchestrator
# OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
API_PORT=8080
WORKER_CONCURRENCY=1
MAX_UPLOAD_BYTES=52428800
USER_STORAGE_QUOTA_BYTES=5368709120
RATE_LIMIT_PER_MINUTE=120
MALWARE_SCAN_REQUIRED=false
# MODEL_MODE=fake runs the whole pipeline with no model server (tests/offline demo).
# MODEL_MODE=ollama uses the local Ollama server; the router then picks a model per
# task from config/models.yaml and OLLAMA_MODEL is the fallback / default.
MODEL_MODE=fake
OLLAMA_BASE_URL=http://localhost:11434
# Strong set (pull with plain `ollama pull`, no local GGUF/Modelfile needed):
#   ollama pull qwen3.6:27b   # reasoner + coder + calc + docs + general (~17 GB)
#   ollama pull qwen3-vl:8b   # vision: scans, screenshots, drawings, handwriting (~6 GB)
#   ollama pull bge-m3        # embeddings, multilingual (~1.2 GB)
OLLAMA_MODEL=qwen3.6:27b
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_KEEP_ALIVE=30m
# 32K fits long documents/code with no measured generation-speed cost on a 32 GB
# M1 Max (benchmarked: 8K/32K/64K context all generate at ~7.2-7.7 tok/s with
# qwen3.6:27b; wired memory only grows ~1 GB going 8K->32K). Model max is 256K.
OLLAMA_NUM_CTX=32768
# Set these when starting `ollama serve` (not read by this app):
#   OLLAMA_FLASH_ATTENTION=1     benchmarked +25% generation speed (6.1 -> 7.7 tok/s)
#   OLLAMA_KV_CACHE_TYPE=q8_0    same speed, ~half the KV-cache memory -- banks
#                                headroom for the bigger context above
#   OLLAMA_NUM_PARALLEL=1        single local user; avoids allocating KV cache
#                                for request slots that are never used
#   OLLAMA_MAX_LOADED_MODELS=1   keeps one heavy model resident at a time on 32 GB
# Qwen3 models emit chain-of-thought unless this is off; keep false, raise LLM_MAX_TOKENS if enabling.
LLM_ENABLE_THINKING=false
LLM_MAX_TOKENS=1536
# Ollama request timeout. Empty = auto (num_predict/3 + 120s) so a big
# LLM_MAX_TOKENS on a slow/cold model isn't cut off mid-generation.
LLM_TIMEOUT_SECONDS=
# Send images / scanned PDFs to the local vision model instead of Tesseract (better on scans/forms/handwriting, slower).
OCR_PREFER_VISION=false
# Wall-clock budget for one vision-OCR pass. Ingest is synchronous -- an upload waits on
# this -- and a dense engineering drawing measured at 393s on an 8B vision model, so it
# will not always finish. On a timeout the file is indexed as "no readable text" rather
# than as OCR noise, and questions about it are answered from the image itself, which the
# orchestrator attaches to the task.
OCR_VISION_TIMEOUT_SECONDS=180

# Agent loop bounds.
MAX_ITERATIONS=3
MAX_TOOL_CALLS=12
# Fail verification when a job's answer is not backed by retrieved evidence.
REQUIRE_EVIDENCE=false

# --- Air-gap / production ---
# Refuse to start unless the control DB and all three RAG tier DBs are PostgreSQL.
REQUIRE_POSTGRES=false
# Embedding vector width; must match the embedding model (bge-m3 / qwen3-embedding = 1024, nomic-embed-text = 768).
RAG_EMBEDDING_DIMENSIONS=1024
# Egress status surface (GET /api/v1/system/network, `cli.py doctor`). These do
# not enforce anything -- the deployment blocks outbound traffic. They report it.
OLLAMA_NO_CLOUD=true
NETWORK_FORBIDDEN=false
# OLLAMA_CLOUD_ENDPOINT=   # leave unset; if set, doctor / /system/network flag it
